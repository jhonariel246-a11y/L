# InsightPay — variables del despliegue (copia a deploy/.env y pon valores reales)
# NUNCA subas deploy/.env al repositorio (está en .gitignore).

# --- Base de datos (Postgres en tu propio servidor) ---
DB_USER=insightpay
DB_PASSWORD=pon-una-clave-larga-aqui
DB_NAME=insightpay

# --- Clave maestra para cifrar los certificados .p12 (32 bytes hex) ---
# Genera una con:  openssl rand -hex 32
INSIGHTPAY_MASTER_KEY=

# --- Secreto para firmar los tokens de sesión (JWT) ---
# Genera uno con:  openssl rand -hex 48
JWT_SECRET=

# --- Origen permitido para CORS (tu dominio) ---
CORS_ORIGIN=https://insightpay.lat
